{
  "manifest_version": 3,
  "name": "GitHub Folder Viewed",
  "description": "Mark every changed file in a pull request folder as viewed from the file tree.",
  "version": "1.3.0",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/pull/*/changes*",
        "https://github.com/*/*/pull/*/files*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
